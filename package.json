{
  "name": "@datachecker/faceverify",
  "version": "v8.2.1",
  "description": "This project contains Datachecker's FaceVerify tool, that captures images of faces to be used in liveness detection. The tool only takes a capture once the trigger mechanism is fired.",
  "main": "dist/faceverify.obf.js",
  "directories": {
    "test": "tests"
  },
  "config": {
    "port": "4321"
  },
  "scripts": {
    "build": "webpack --config webpack.config.js && webpack --config webpack.worker.js",
    "build:dev": "webpack --config webpack.dev.js  && webpack --config webpack.worker.js",
    "start-server": "http-server -p $npm_package_config_port",
    "start-server:diag": "node dev-server.js",
    "cypress:open": "cypress open --project tests/integration",
    "cypress:run": "cypress run --project tests/integration",
    "pretest:e2e": "npm run build",
    "test:e2e": "start-server-and-test start-server http://localhost:$npm_package_config_port cypress:run",
    "test:e2e:open": "start-server-and-test start-server http://localhost:$npm_package_config_port cypress:open",
    "test:smoke": "cypress run --project tests/integration --spec 'tests/integration/cypress/e2e/smoke.cy.js'",
    "test": "jest --coverage --config=tests/unit/jest.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacheckerbv/FaceVerify.git"
  },
  "author": "Fabian Afatsawo",
  "license": "SEE LICENSE IN LICENSE.md",
  "bugs": {
    "url": "https://github.com/datacheckerbv/FaceVerify/issues"
  },
  "homepage": "https://github.com/datacheckerbv/FaceVerify#readme",
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@mediapipe/tasks-vision": "0.10.21",
    "babel-jest": "^29.7.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.9.1",
    "cypress": "^15.18.1",
    "file-loader": "^6.2.0",
    "http-server": "^14.1.1",
    "javascript-obfuscator": "^4.1.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "start-server-and-test": "^3.0.11",
    "style-loader": "^3.3.4",
    "url-loader": "^4.1.1",
    "webpack-cli": "^5.1.4",
    "webpack-obfuscator": "^3.5.1",
    "webpack-shell-plugin-next": "^2.3.1"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "docs/",
    "CHANGELOG.md",
    "LICENSE.md",
    "NOTICE.md",
    "README.md"
  ],
  "dependencies": {
    "wasm-feature-detect": "^1.6.1"
  }
}
